  "narrative": {
    "northStar": "The Analytical Workbench",
    "overview": "SkyGraph is a quiet, precise operating environment. Pale blue-gray surfaces, dark ink, and restrained blue actions support scanning and recovery without competing with the content. The system UI face is a deliberate choice for sustained use; this is an operating interface, not a display-led brand treatment.\n\nThe shipped shell is spacious but bounded: compact navigation, a dominant working area, and subordinate explanatory text. Empty, loading, unavailable-service, and unexpected-error views share the same calm container language. The interface communicates what is known through explicit wording rather than decorative status theater.",
    "keyCharacteristics": [
      "Cool tonal surfaces with restrained blue actions.",
      "Compact controls inside a spacious, bounded workspace.",
      "System UI typography with clear weight and size hierarchy.",
      "Text-led states, visible focus, and minimal motion."
    ],
    "rules": [
      {
        "name": "The Action Blue Rule",
        "body": "Reserve saturated blue for actionable elements and current navigation; explanatory surfaces remain cool and quiet.",
        "section": "colors"
      },
      {
        "name": "The Words Before Color Rule",
        "body": "State messages name the condition and recovery action; a colored mark alone never communicates availability.",
        "section": "colors"
      },
      {
        "name": "The Operating Type Rule",
        "body": "Keep operating text in the shared UI stack; use the existing hierarchy rather than introducing display branding into task controls.",
        "section": "typography"
      },
      {
        "name": "The Bounded Workspace Rule",
        "body": "Let the working region grow, but constrain explanatory line lengths and state-panel width; extra viewport space is not a reason to stretch prose.",
        "section": "layout"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Separate regions with tone and a restrained border; do not add floating-card shadows to the established workbench.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared UI type stack and recorded hierarchy for operating surfaces.",
      "Do preserve explicit state wording and real recovery actions.",
      "Do keep keyboard focus visible and honor reduced-motion and forced-color preferences.",
      "Do separate the main working area from bounded explanatory text."
    ],
    "donts": [
      "Don't imply available flight data from an API health response.",
      "Don't replace textual state explanations with color-only indicators.",
      "Don't add shadows to the flat tonal surface system.",
      "Don't document unimplemented maps, graphs, metrics, or simulation results as existing components."
    ]
  }

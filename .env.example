# Copy this file to the environment-specific location used by the relevant
# deployable unit. Never commit real credentials.

NODE_ENV=development
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=3000
API_REQUEST_BODY_LIMIT_BYTES=1048576
API_SHUTDOWN_TIMEOUT_MS=10000
METRICS_ENABLED=true
WEB_ORIGIN=http://localhost:5173

# Durable storage
DATABASE_URL=postgresql://skygraph:change-me@localhost:5432/skygraph

# Ephemeral cache and resilience state
REDIS_URL=redis://localhost:6379

# External ingestion providers
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
ADSB_EXCHANGE_API_KEY=

# Internal ML service boundary
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TOKEN=

# Minimal scenario-saving authentication
JWT_SECRET=
JWT_ISSUER=skygraph-local
JWT_AUDIENCE=skygraph-web

# Frontend build-time configuration
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_WS_URL=ws://localhost:3000
